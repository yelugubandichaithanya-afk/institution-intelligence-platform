# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET — server only, never put in frontend code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Comma-separated origins allowed to call the API (add your Vercel URL later)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FLASK_DEBUG=1

# Supabase → Connect → Direct connection (only needed to apply schema.sql from the CLI)
DATABASE_URL=postgresql://postgres:URL-ENCODED-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Public website URL (confirmation emails link back here)
SITE_URL=http://localhost:5500
